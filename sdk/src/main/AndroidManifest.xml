<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Единственное разрешение SDK: чат ходит по HTTPS в meerbot.ru. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
            Контекст приложения до MeerBot.configure(...): без него выход, запрошенный раньше
            настройки, жил бы только в памяти и терялся с процессом. Своего провайдера нет —
            запись в общем InitializationProvider androidx.startup, который у хоста уже есть.
            Инициализатор только запоминает контекст и диск не трогает.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="ru.meerbot.sdk.internal.MeerBotInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
